# Proxmox API Configuration
# Copy this file to .env and fill in your values

# Proxmox host URL (e.g. https://192.168.1.100:8006)
PROXMOX_HOST=https://your-proxmox-host:8006

# API Token ID (format: user@realm!tokenname)
PROXMOX_TOKEN_ID=root@pam!your-token-name

# API Token Secret
PROXMOX_TOKEN_SECRET=your-token-secret-here

# Target Proxmox node name
PROXMOX_NODE=pmx-4
